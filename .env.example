# -----------------------------------------------------------------------------
# TechScreen Pro — Environment Configuration Specification
# -----------------------------------------------------------------------------

# Server Port
PORT=5000

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Database URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/techscreen_pro?schema=public"

# Redis Cache & Proctoring Sessions
REDIS_URL="redis://localhost:6379"

# JWT Secret Configuration
# CRITICAL: In production, JWT_SECRET MUST be a cryptographically secure random string
# with a minimum of 32 characters (e.g. openssl rand -base64 32).
# The application will fail to start in production if this is left at default or under 32 chars.
JWT_SECRET="techscreen-dev-secret-local-only-2026-minimum-length-key"

# JWT Expiration Duration (e.g. '8h', '24h', '7d')
JWT_EXPIRES_IN="8h"

# Application Base URL for link generation
APP_URL="http://localhost:3000"

# Allowed CORS Origins (comma-separated list, e.g. http://3.231.102.135 or https://app.example.com)
ALLOWED_ORIGINS=http://localhost:3000

# Storage Driver ('local' or 's3')
STORAGE_DRIVER="local"

# -----------------------------------------------------------------------------
# EMAIL DELIVERY CONFIGURATION
# -----------------------------------------------------------------------------
# Option 1: Gmail (App Password with 2FA enabled)
# GMAIL_USER=recruiter@yourcompany.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option 2: Custom SMTP (SendGrid, Mailgun, AWS SES, Brevo, Postmark)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key
# SMTP_FROM="TechScreen Pro" <no-reply@techscreen.io>

# Default behavior when no SMTP is configured:
# Uses ephemeral Ethereal test mailer with instant URL preview in console.
